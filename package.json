{
  "name": "nfinity-talent-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build && node scripts/normalize-export.mjs",
    "start": "serve out -l tcp://127.0.0.1:3002",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.tsx",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "next": "16.3.5",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^29.1.1",
    "prettier": "latest",
    "serve": "^14.2.6",
    "tsx": "latest",
    "typescript": "latest"
  }
}
